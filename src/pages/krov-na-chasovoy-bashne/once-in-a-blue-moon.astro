---
import BotcShell from '../../components/BotcShell.astro';
const groups = [["Горожане",[["Аристократ","Три стартовых подозреваемых; злой среди них ровно один."],["Библиотекарь","Стартовая проверка: указанный Изгой — один из двух игроков; возможен ответ об отсутствии Изгоев."],["Эмпат","Ночью считает злых среди ближайших живых соседей."],["Математик","Ночью получает число игроков, чьи способности сработали неправильно из-за чужих способностей с прошлого рассвета."],["Король","Получает ночью роль живого игрока, когда мёртвых не меньше, чем живых. Демону известен Король."],["Сновидец","Ночью выбирает другого игрока, кроме Странника: получает две роли, добрую и злую; одна настоящая."],["Гадалка","Ночью проверяет пару на Демона. Есть добрый игрок, дающий ложное срабатывание."],["Акробат","Начиная со второй ночи выбирает игрока. Если выбранный пьян или отравлен этой ночью, Акробат погибает."],["Оборотень","Со второй ночи выбирает живого. Добрый выбранный погибает, а убийство Демона этой ночью отменяется. Есть добрый игрок, определяющийся злым."],["Швея","Одна ночная проверка за игру: совпадают ли стороны двух других игроков."],["Рыбак","Раз за игру днём получает у Рассказчика личный совет для победы своей команды."],["Хорист","Узнаёт Демона, если тот убивает Короля. Добавляет Короля в игру."],["Фокусник","В стартовом знакомстве вводит зло в заблуждение: Демон видит его Приспешником, Приспешники — Демоном."]]],["Изгои",[["Наемник","Первый выбравший его ночью своей способностью пьянеет до заката; Наемник принимает его сторону."],["Безумец","Считает себя Демоном. Настоящий Демон знает его и его ночные выборы."],["Пьяница","Получает роль Горожанина и считает себя им, но этой способности не имеет."],["Затворник","Может давать злую регистрацию, включая регистрацию Демоном или Приспешником, даже после смерти."],["Душечка","Смерть делает одного игрока пьяным до конца игры."]]],["Приспешники",[["Крестный отец","Знает стартовых Изгоев. После дневной смерти Изгоя ночью получает убийство. Меняет число Изгоев на +1 или −1."],["Отравитель","Ночью выбирает жертву отравления до конца следующего дня."],["Шпион","Видит Гримуар каждую ночь; может регистрироваться добрым Горожанином или Изгоем даже после смерти."],["Марионетка","Сидит рядом с Демоном и считает себя добрым персонажем. Демон знает её."],["Блудница","При смерти Демона становится новым Демоном, если живы минимум пять игроков без учёта Странников."]]],["Демоны",[["Пукка","Ночью отравляет выбранного игрока; прежняя жертва затем погибает и избавляется от яда."],["Черт","Со второй ночи убивает выбранного. Выбрав себя, передаёт роль одному из Приспешников."]]],["Странники",[["Бариста","Ночью даёт одному игроку до заката либо трезвость, здоровье и верную информацию, либо двойное срабатывание способности. Игрок узнаёт эффект."],["Распутница","Со второй ночи предлагает живому игроку раскрыть роль. При согласии узнаёт её; оба рискуют погибнуть."],["Собиратель костей","Раз за игру со второй ночи возвращает мёртвому его способность до заката."],["Судья","Раз за игру после чужой номинации решает, состоится ли казнь."],["Ученик","На старте получает способность Горожанина на стороне добра или Приспешника на стороне зла."]]]];
const faq = [
{ q: 'Подходит ли Once in a Blue Moon для первой игры?', a: 'Сценарий содержит сложные взаимодействия и скрытую информацию. Сначала полезно освоить базовые правила и Trouble Brewing; перед партией попросите Рассказчика объяснить незнакомые роли.' },
{ q: 'Все перечисленные роли участвуют в одной партии?', a: 'Нет. Это список возможных ролей. Конкретный состав тайно выбирает Рассказчик; игроки знают сценарий, но не знают, какие роли действительно в игре.' },
{ q: 'Где посмотреть подробные правила персонажей?', a: 'В русской вики сценария есть ссылки на каждую роль. Перед партией сверяйте версию памятки с Рассказчиком: экспериментальные способности могут меняться.' }
];
---
<BotcShell
 title="Once in a Blue Moon: роли и правила | Party Game Нячанг"
 description="Русская памятка сценария Once in a Blue Moon для «Крови на часовой башне»: роли, правила, отравление, смена Демона и важные взаимодействия."
 h1="Once in a Blue Moon"
 lede="Памятка по сценарию «Крови на часовой башне»: прочитайте общие правила, найдите свою роль и держите список персонажей под рукой во время партии."
 crumbs={[{name:'Кровь на часовой башне',href:'/krov-na-chasovoy-bashne/'},{name:'Once in a Blue Moon',href:'/krov-na-chasovoy-bashne/once-in-a-blue-moon/'}]}
 color="#86baff"
 badge="Сценарий · A. Taizermann и Drevoed"
 faq={faq}
>
 <nav aria-label="Разделы памятки" class="contents">
   <a href="#rules">Правила</a>
   <a href="#roles">Роли</a>
   <a href="#interactions">Важные взаимодействия</a>
   <a href="#sources">Полная памятка</a>
 </nav>
 <h2 id="rules">Как играть</h2>
 <p>Это отдельный сценарий: набор возможных персонажей для обычной игры в «Кровь на часовой башне». Перед началом все получают один и тот же список ролей. Рассказчик тайно выбирает состав партии и объясняет способности.</p>
 <ol>
   <li><strong>Ночью</strong> закрывайте глаза и действуйте только по приглашению Рассказчика. Не показывайте остальным, просыпались ли вы.</li>
   <li><strong>Днём</strong> обсуждайте сведения и подозрения. Можно разговаривать лично, скрывать свою роль и блефовать.</li>
   <li><strong>Казнь</strong> проходит после номинаций и голосования. Для постановки на казнь нужно не меньше половины голосов живых; при равенстве максимальных результатов казни нет. За день казнят не более одного игрока.</li>
   <li><strong>После смерти</strong> оставайтесь в обсуждении. Способность обычно теряется, номинировать нельзя, но остаётся один голос на всю оставшуюся игру.</li>
 </ol>
 <p><strong>Добро выигрывает, когда живого Демона больше нет; зло — когда живых игроков остаётся двое.</strong> Перед объявлением победы Рассказчик учитывает способности: смерть Демона не всегда заканчивает игру.</p>
 <p>Базовые понятия разобраны в <a href="/blog/pravila-krovi-na-chasovoy-bashne/">правилах для новичков</a>. Более простой сценарий — <a href="/krov-na-chasovoy-bashne/trouble-brewing/">Trouble Brewing</a>.</p>
 <h2 id="roles">Все роли сценария</h2>
 <p>Ниже — краткие объяснения для быстрого поиска. Для спорного случая используйте полное описание роли и решение Рассказчика. «Со второй ночи» означает, что способность не действует в первую ночь.</p>
 {groups.map(([team, list]) => (
   <section class="role-team">
     <h3>{team}</h3>
     {list.map(([name, ability]) => (
       <details class="role">
         <summary>{name}</summary>
         <p>{ability}</p>
       </details>
     ))}
   </section>
 ))}
 <h2 id="interactions">Что проверить перед выводами</h2>
 <ul>
   <li><strong>Пьянство и яд.</strong> Игрок обычно не знает о состоянии; его способность не работает, а информация может быть ложной. Полученное ночью число само по себе не доказывает роль.</li>
   <li><strong>Регистрация и сторона.</strong> Способность может видеть игрока иначе, чем он есть на самом деле. Сопоставляйте несколько проверок.</li>
   <li><strong>Смена Демона.</strong> Проверяйте, могло ли зло передать роль после смерти прежнего Демона. Важны число живых и способ смерти.</li>
   <li><strong>Пукка.</strong> Учитывайте отложенное убийство: выбранный ночью игрок и погибший этой ночью могут быть разными людьми.</li>
   <li><strong>Фокусник и Шпион.</strong> В этом сценарии действует особое взаимодействие: при просмотре Гримуара Шпионом жетоны Демона и Фокусника убираются.</li>
 </ul>
 <h2 id="sources">Полные правила и версия сценария</h2>
 <p>Авторы сценария — A. Taizermann и Drevoed. Список ролей и особое взаимодействие сверены с русской вики. Перед игрой используйте ту же версию сценария, что и Рассказчик.</p>
 <ul>
   <li><a href="https://botc.1nv.is/wiki/Once_in_a_Blue_Moon" target="_blank" rel="noopener noreferrer">Русская вики: сценарий, полные описания ролей и памятки</a></li>
   <li><a href="https://www.botcscripts.com/script/10121" target="_blank" rel="noopener noreferrer">Карточка сценария на BOTC Scripts</a></li>
 </ul>
</BotcShell>
<style>
 .contents{display:flex;flex-wrap:wrap;gap:.6rem;margin-bottom:2rem}
 .contents a{padding:.5rem .8rem;border:1px solid var(--line);border-radius:12px;text-decoration:none}
 .role-team{margin-block:2rem}
 .role{border:1px solid var(--line);border-radius:12px;margin:.6rem 0;padding:.85rem 1rem;background:var(--felt)}
 .role summary{cursor:pointer;font-weight:700;min-height:1.5rem}
 .role p{margin:.8rem 0 .2rem}
</style>
