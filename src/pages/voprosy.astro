---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Faq from '../components/Faq.astro';
import JoinBand from '../components/JoinBand.astro';
import { faqMain } from '../data/faq';
import { breadcrumbs, faqSchema } from '../data/schema';

const crumb = [{ name: 'Частые вопросы', href: '/voprosy/' }];

const extra = [
  {
    q: 'Чем заняться вечером в Нячанге, если не хочется в бар?',
    a: 'Один из вариантов — прийти на вечер социальных игр в клуб Party Game. Мафия, Авалон и Тайный Гитлер проходят с четверга по воскресенье с 19:00 до 23:00 в центре Нячанга: это знакомства, эмоции и русскоязычная компания без алкоголя в обязательной программе.',
  },
  {
    q: 'Как найти русскоязычную компанию в Нячанге?',
    a: 'Игровые вечера клуба Party Game проходят на русском, и за столом собираются туристы, зимовщики и те, кто живёт в Нячанге постоянно. В Telegram-группе клуба больше 400 человек.',
  },
  {
    q: 'Можно прийти компанией друзей?',
    a: 'Да, приходите вместе. Предупредите ведущую при записи, сколько вас будет, чтобы для всех хватило мест.',
  },
  {
    q: 'Есть ли возрастные ограничения?',
    a: 'Игры рассчитаны на взрослых. Если хотите прийти с подростком, уточните у ведущей при записи.',
  },
  {
    q: 'Что делать, если планы изменились?',
    a: 'Отмените запись в группе или напишите ведущей как можно раньше, чтобы ваше место могли отдать другому игроку.',
  },
  {
    q: 'Можно оплатить переводом?',
    a: 'Оплата принимается ведущему в начале вечера. Способ оплаты уточняйте при записи.',
  },
];
const all = [...faqMain, ...extra];
---

<Base
  title="Частые вопросы о мафии и настольных играх в Нячанге | Party Game"
  description="Ответы на вопросы о клубе Party Game в Нячанге: где поиграть в мафию, сколько стоит, можно ли новичку и одному, как записаться, на каком языке игры."
  schema={[breadcrumbs(crumb), faqSchema(all)]}
>
  <Crumbs items={crumb} />
  <header class="page-hero wrap">
    <h1>Частые вопросы</h1>
    <p class="lede">Всё, что обычно спрашивают перед первой игрой. Не нашли ответ — напишите Юлиане в Telegram.</p>
  </header>
  <div class="narrow" style="padding-bottom:5rem">
    <Faq items={all} title="Вопросы и ответы" />
  </div>
  <JoinBand />
</Base>
