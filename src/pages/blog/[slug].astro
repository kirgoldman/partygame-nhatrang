---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Faq from '../../components/Faq.astro';
import JoinBand from '../../components/JoinBand.astro';
import { article, breadcrumbs, faqSchema } from '../../data/schema';
import { coverOf } from '../../data/blog';
import { existsSync } from 'node:fs';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const href = `/blog/${post.id}/`;
const crumb = [
  { name: 'Блог', href: '/blog/' },
  { name: d.h1 ?? d.title, href },
];
const ogFile = `/og/blog/${post.id}.jpg`;
const ogImage = coverOf(post.body) && existsSync(new URL(`../../../public${ogFile}`, import.meta.url)) ? ogFile : undefined;
const fmt = (x: Date) => x.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
const schema = [
  breadcrumbs(crumb),
  article({ title: d.h1 ?? d.title, description: d.description, href, date: d.date, updated: d.updated, image: ogImage }),
  ...(d.faq ? [faqSchema(d.faq)] : []),
];

const all = await getCollection('blog');
// Подбираем статьи по теме; новые материалы получают подборку из своей рубрики.
const relatedIds: Record<string, string[]> = {
  'pervyy-vecher-mafii-v-nyachange': ['pravila-mafii-dlya-novichkov', 'mafiya-avalon-ili-krov-na-chasovoy-bashne', 'kak-najti-druzej-v-nyachange'],
  'chem-zanyatsya-v-nyachange-odnomu': ['kak-najti-druzej-v-nyachange', 'mafiya-avalon-ili-krov-na-chasovoy-bashne', 'chem-zanyatsya-vecherom-v-nyachange'],
  'chem-zanyatsya-v-nyachange-v-dozhd': ['chem-zanyatsya-vecherom-v-nyachange', 'kuda-poyti-v-nyachange-s-kompaniey', 'chem-zanyatsya-v-nyachange-odnomu'],
  'chem-zanyatsya-vecherom-v-nyachange': ['chem-zanyatsya-v-nyachange-v-dozhd', 'kuda-poyti-v-nyachange-s-kompaniey', 'nyachang-na-zimovku-chem-zanyat-vechera'],
  'kak-najti-druzej-v-nyachange': ['chem-zanyatsya-v-nyachange-odnomu', 'nyachang-na-zimovku-chem-zanyat-vechera', 'kuda-poyti-v-nyachange-s-kompaniey'],
  'kuda-poyti-v-nyachange-s-kompaniey': ['mafiya-avalon-ili-krov-na-chasovoy-bashne', 'chem-zanyatsya-vecherom-v-nyachange', 'chem-zanyatsya-v-nyachange-v-dozhd'],
  'nyachang-na-zimovku-chem-zanyat-vechera': ['kak-najti-druzej-v-nyachange', 'chem-zanyatsya-vecherom-v-nyachange', 'chem-zanyatsya-v-nyachange-v-dozhd'],
  'mafiya-avalon-ili-krov-na-chasovoy-bashne': ['pravila-mafii-dlya-novichkov', 'pravila-avalona', 'pravila-krovi-na-chasovoy-bashne'],
  'nyachang-ne-ponravilsya-v-pervye-dni': ['kak-najti-druzej-v-nyachange', 'chem-zanyatsya-v-nyachange-odnomu', 'pervyy-vecher-mafii-v-nyachange'],
  'gorodskaya-mafiya-ili-sportivnaya': ['pravila-mafii-dlya-novichkov', 'roli-maniyak-himik-karatel-v-mafii', 'pervyy-vecher-mafii-v-nyachange'],
  'roli-maniyak-himik-karatel-v-mafii': ['pravila-mafii-dlya-novichkov', 'kak-vrat-i-lovit-vrunov-v-mafii', 'gorodskaya-mafiya-ili-sportivnaya'],
  'kak-vesti-mafiyu-pamyatka-vedushchemu': ['pravila-mafii-dlya-novichkov', 'roli-maniyak-himik-karatel-v-mafii', 'kak-vrat-i-lovit-vrunov-v-mafii'],
  'kak-vrat-i-lovit-vrunov-v-mafii': ['pravila-mafii-dlya-novichkov', 'roli-maniyak-himik-karatel-v-mafii', 'pervyy-vecher-mafii-v-nyachange'],
  'chem-zanyatsya-v-nyachange-devushke-vecherom': ['chem-zanyatsya-v-nyachange-odnomu', 'kak-najti-druzej-v-nyachange', 'chem-zanyatsya-vecherom-v-nyachange'],
  'nyachang-udalenka-kak-ne-sidet-doma-vecherom': ['nyachang-na-zimovku-chem-zanyat-vechera', 'kak-najti-druzej-v-nyachange', 'chem-zanyatsya-v-nyachange-odnomu'],
  'kuda-shodit-v-nyachange-s-roditelyami': ['chem-zanyatsya-vecherom-v-nyachange', 'chem-zanyatsya-v-nyachange-v-dozhd', 'kuda-poyti-v-nyachange-s-kompaniey'],
  'tet-2027-v-nyachange-chto-zakryto': ['nyachang-na-zimovku-chem-zanyat-vechera', 'chem-zanyatsya-v-nyachange-v-dozhd', 'chem-zanyatsya-vecherom-v-nyachange'],
  'chem-zanyatsya-v-nyachange-po-dnyam-nedeli': ['chem-zanyatsya-vecherom-v-nyachange', 'kuda-poyti-v-nyachange-s-kompaniey', 'mafiya-avalon-ili-krov-na-chasovoy-bashne'],
  'novyy-god-2027-v-nyachange-chem-zanyatsya': ['nyachang-v-dekabre-pogoda-i-chem-zanyatsya', 'chem-zanyatsya-vecherom-v-nyachange', 'kuda-poyti-v-nyachange-s-kompaniey'],
  'nyachang-v-dekabre-pogoda-i-chem-zanyatsya': ['novyy-god-2027-v-nyachange-chem-zanyatsya', 'nyachang-na-zimovku-chem-zanyat-vechera', 'chem-zanyatsya-v-nyachange-v-dozhd'],
  'kak-igrat-za-mafiyu-taktika': ['kak-igrat-za-mirnyh-komissar-i-doktor', 'kak-vrat-i-lovit-vrunov-v-mafii', 'pravila-mafii-dlya-novichkov'],
  'kak-igrat-za-mirnyh-komissar-i-doktor': ['kak-igrat-za-mafiyu-taktika', 'kak-vrat-i-lovit-vrunov-v-mafii', 'roli-maniyak-himik-karatel-v-mafii'],
  'taktika-avalona-kak-igrat-za-dobryh-i-zlyh': ['pravila-avalona', 'sovety-novichku-krov-na-chasovoy-bashne', 'mafiya-avalon-ili-krov-na-chasovoy-bashne'],
  'sovety-novichku-krov-na-chasovoy-bashne': ['pravila-krovi-na-chasovoy-bashne', 'taktika-avalona-kak-igrat-za-dobryh-i-zlyh', 'mafiya-avalon-ili-krov-na-chasovoy-bashne'],
  'svidanie-v-nyachange-chem-zanyatsya-vdvoem': ['chem-zanyatsya-vecherom-v-nyachange', 'chem-zanyatsya-v-nyachange-devushke-vecherom', 'kuda-poyti-v-nyachange-s-kompaniey'],
  'den-rozhdeniya-v-nyachange-kak-otmetit': ['kuda-poyti-v-nyachange-s-kompaniey', 'kak-najti-druzej-v-nyachange', 'mafiya-avalon-ili-krov-na-chasovoy-bashne'],
  'nyachang-introvertu-kak-vlitsya-v-kompaniyu': ['kak-najti-druzej-v-nyachange', 'pervyy-vecher-mafii-v-nyachange', 'chem-zanyatsya-v-nyachange-odnomu'],
  'nyachang-na-mesyac-plan-na-chetyre-nedeli': ['nyachang-na-zimovku-chem-zanyat-vechera', 'chem-zanyatsya-v-nyachange-po-dnyam-nedeli', 'kak-najti-druzej-v-nyachange'],
  'pogoda-v-nyachange-po-mesyacam-kogda-ehat': ['nyachang-v-dekabre-pogoda-i-chem-zanyatsya', 'nyachang-v-yanvare-pogoda-i-chem-zanyatsya', 'nyachang-na-mesyac-plan-na-chetyre-nedeli'],
  'nyachang-v-yanvare-pogoda-i-chem-zanyatsya': ['nyachang-v-dekabre-pogoda-i-chem-zanyatsya', 'nyachang-v-fevrale-pogoda-i-chem-zanyatsya', 'pogoda-v-nyachange-po-mesyacam-kogda-ehat'],
  'nyachang-v-fevrale-pogoda-i-chem-zanyatsya': ['nyachang-v-yanvare-pogoda-i-chem-zanyatsya', 'nyachang-v-marte-pogoda-i-chem-zanyatsya', 'tet-2027-v-nyachange-chto-zakryto'],
  'nyachang-v-marte-pogoda-i-chem-zanyatsya': ['nyachang-v-fevrale-pogoda-i-chem-zanyatsya', 'pogoda-v-nyachange-po-mesyacam-kogda-ehat', 'plyazhi-nyachanga-kakoj-vybrat'],
  'plyazhi-nyachanga-kakoj-vybrat': ['pogoda-v-nyachange-po-mesyacam-kogda-ehat', 'chto-posmotret-v-nyachange-samostoyatelno', 'chem-zanyatsya-vecherom-v-nyachange'],
  'chto-posmotret-v-nyachange-samostoyatelno': ['plyazhi-nyachanga-kakoj-vybrat', 'chem-zanyatsya-vecherom-v-nyachange', 'chem-zanyatsya-v-nyachange-po-dnyam-nedeli'],
  'nyachang-ili-fukuok-chto-luchshe': ['pogoda-v-nyachange-po-mesyacam-kogda-ehat', 'plyazhi-nyachanga-kakoj-vybrat', 'nyachang-na-zimovku-chem-zanyat-vechera'],
  'roli-v-mafii-polnyj-spisok': ['roli-maniyak-himik-karatel-v-mafii', 'kak-igrat-za-mirnyh-komissar-i-doktor', 'pravila-mafii-dlya-novichkov'],
  'chto-takoe-igra-mafiya-kak-igrat': ['pravila-mafii-dlya-novichkov', 'roli-v-mafii-polnyj-spisok', 'pervyy-vecher-mafii-v-nyachange'],
  'igry-dlya-kompanii-vzroslyh-za-stolom': ['mafiya-avalon-ili-krov-na-chasovoy-bashne', 'chto-takoe-igra-mafiya-kak-igrat', 'kak-najti-druzej-v-nyachange'],
  'nyachang-v-noyabre-pogoda-i-chem-zanyatsya': ['sezon-dozhdey-v-nyachange-stoit-li-ehat', 'nyachang-v-dekabre-pogoda-i-chem-zanyatsya', 'chem-zanyatsya-v-nyachange-v-dozhd'],
  'nyachang-v-aprele-pogoda-i-chem-zanyatsya': ['nyachang-v-marte-pogoda-i-chem-zanyatsya', 'nyachang-letom-pogoda-i-kogda-ehat', 'plyazhi-nyachanga-kakoj-vybrat'],
  'nyachang-letom-pogoda-i-kogda-ehat': ['nyachang-v-aprele-pogoda-i-chem-zanyatsya', 'pogoda-v-nyachange-po-mesyacam-kogda-ehat', 'plyazhi-nyachanga-kakoj-vybrat'],
  'sezon-dozhdey-v-nyachange-stoit-li-ehat': ['nyachang-v-noyabre-pogoda-i-chem-zanyatsya', 'chem-zanyatsya-v-nyachange-v-dozhd', 'pogoda-v-nyachange-po-mesyacam-kogda-ehat'],
  'ostrova-nyachanga-kakoj-vybrat': ['chto-posmotret-v-nyachange-samostoyatelno', 'plyazhi-nyachanga-kakoj-vybrat', 'kak-dobratsya-do-nyachanga'],
  'rynki-nyachanga-cho-dam-i-nochnoj-rynok': ['chto-privezti-iz-nyachanga', 'chem-zanyatsya-vecherom-v-nyachange', 'chto-posmotret-v-nyachange-samostoyatelno'],
  'kak-dobratsya-do-nyachanga': ['ostrova-nyachanga-kakoj-vybrat', 'pogoda-v-nyachange-po-mesyacam-kogda-ehat', 'nyachang-na-mesyac-plan-na-chetyre-nedeli'],
  'chto-privezti-iz-nyachanga': ['rynki-nyachanga-cho-dam-i-nochnoj-rynok', 'chto-posmotret-v-nyachange-samostoyatelno', 'kak-dobratsya-do-nyachanga'],
  'igry-dlya-vzroslyh-na-den-rozhdeniya': ['igry-dlya-kompanii-vzroslyh-za-stolom', 'den-rozhdeniya-v-nyachange-kak-otmetit', 'chto-takoe-igra-mafiya-kak-igrat'],
  'nastolnye-igry-dlya-dvoih': ['igry-dlya-kompanii-vzroslyh-za-stolom', 'svidanie-v-nyachange-chem-zanyatsya-vdvoem', 'mafiya-avalon-ili-krov-na-chasovoy-bashne'],
  'pravila-mafii-dlya-novichkov': ['pervyy-vecher-mafii-v-nyachange', 'mafiya-avalon-ili-krov-na-chasovoy-bashne', 'pravila-avalona'],
  'pravila-avalona': ['mafiya-avalon-ili-krov-na-chasovoy-bashne', 'pravila-mafii-dlya-novichkov', 'pravila-krovi-na-chasovoy-bashne'],
  'pravila-krovi-na-chasovoy-bashne': ['mafiya-avalon-ili-krov-na-chasovoy-bashne', 'pravila-mafii-dlya-novichkov', 'pravila-avalona'],
};
const preferred = relatedIds[post.id] ?? [];
const related = [
  ...preferred.map((id) => all.find((p) => p.id === id)),
  ...all.filter((p) => p.data.tag === d.tag),
  ...all,
].filter((p, index, candidates) => p && p.id !== post.id && candidates.findIndex((candidate) => candidate?.id === p.id) === index).slice(0, 3);
---

<Base title={d.title.length > 52 ? d.title : `${d.title} | Party Game`} description={d.description} schema={schema} ogType="article" ogImage={ogImage}>
  <Crumbs items={crumb} />
  <article>
    <header class="page-hero narrow post-head">
      <p class="tag">{d.tag}</p>
      <h1>{d.h1 ?? d.title}</h1>
      <p class="byline muted">
        Автор: <a href="/o-klube/">Ведущая клуба Party Game</a><br />
        <time datetime={d.date.toISOString()}>{fmt(d.date)}</time>{d.updated && d.updated.valueOf() !== d.date.valueOf() && (
          <>, обновлено <time datetime={d.updated.toISOString()}>{fmt(d.updated)}</time></>
        )}
      </p>
    </header>
    <div class="narrow prose">
      <Content />
    </div>
    {
      d.faq && (
        <div class="narrow post-faq">
          <Faq items={d.faq} />
        </div>
      )
    }
  </article>

  <aside class="section narrow related" aria-labelledby="rel-h">
    <h2 id="rel-h">Читайте также</h2>
    <ul>
      {
        related.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`}>{p.data.h1 ?? p.data.title}</a>
          </li>
        ))
      }
    </ul>
  </aside>
  <JoinBand />
</Base>

<style>
  .post-head h1 {
    font-size: var(--step-4);
    max-width: none;
  }
  .tag {
    color: var(--avalon);
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .byline {
    font-size: var(--step--1);
  }
  .byline a {
    color: var(--text);
  }
  .post-faq {
    padding-top: 3rem;
  }
  .related h2 {
    font-size: var(--step-3);
  }
  .related ul {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .related li {
    border-bottom: 1px solid var(--line);
  }
  .related a {
    display: block;
    padding: 1rem 0;
    text-decoration: none;
    font-weight: 600;
  }
  .related a:hover {
    color: var(--avalon);
  }
</style>
