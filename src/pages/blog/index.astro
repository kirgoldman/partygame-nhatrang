---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import JoinBand from '../../components/JoinBand.astro';
import PostCards from '../../components/PostCards.astro';
import { breadcrumbs } from '../../data/schema';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const crumb = [{ name: 'Блог', href: '/blog/' }];
const groups = ['Досуг в Нячанге', 'Правила игр'] as const;
---

<Base
  title="Блог клуба Party Game — досуг в Нячанге и правила игр"
  description="Статьи о том, чем заняться вечером в Нячанге, как найти компанию, и правила мафии, Авалона и «Крови на часовой башне» простым языком."
  schema={[breadcrumbs(crumb)]}
>
  <Crumbs items={crumb} />
  <header class="page-hero wrap">
    <h1>Блог</h1>
    <p class="lede">Чем заняться в Нячанге, где найти своих людей и как играть в мафию, Авалон и «Кровь на часовой башне».</p>
  </header>
  <div class="wrap blog-groups">
    {
      groups.map((g) => (
        <section>
          <h2>{g}</h2>
          <PostCards posts={posts.filter((p) => p.data.tag === g)} />
        </section>
      ))
    }
  </div>
  <div class="section"></div>
  <JoinBand />
</Base>

<style>
  .blog-groups {
    display: grid;
    gap: 3.5rem;
  }
  h2 {
    font-size: var(--step-3);
    margin-bottom: 1.2rem;
  }
</style>
