---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import JoinBand from '../components/JoinBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { breadcrumbs, place } from '../data/schema';

const crumb = [{ name: 'Где играем', href: '/gde-my-igraem/' }];
const v = site.venue;
---

<Base
  title="Где играть в мафию в Нячанге — CCCP Coffee, 112 Hồng Bàng | Party Game"
  description="Игры клуба Party Game проходят в CCCP Coffee: 112 Đ. Hồng Bàng, центр Нячанга. Четверг–воскресенье, 19:00–23:00. Карта, адрес и как добраться."
  schema={[breadcrumbs(crumb), place]}
>
  <Crumbs items={crumb} />
  <header class="page-hero wrap">
    <h1>Где мы играем</h1>
    <p class="lede">
      Все игровые вечера проходят в кафе {v.name} в центре Нячанга: {v.street}. С четверга по воскресенье, с 19:00 до 23:00.
    </p>
  </header>

  <section class="wrap place-grid">
    <address class="addr">
      <span class="name">{v.name}</span>
      <span>{v.street}</span>
      <span>{v.cityLatin}, {v.region} {v.postalCode}</span>
      <span>{v.countryRu}</span>
      <span class="time">Игры: Чт–Вс, {site.hours}</span>
      <a class="btn btn-primary" href={v.mapUrl} rel="noopener"><Icon name="pin" /> Открыть в Google Maps</a>
    </address>
    <div class="map">
      <iframe
        title="CCCP Coffee на карте Нячанга"
        src={v.mapEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>
  </section>

  <section class="section narrow prose">
    <h2>Как добраться до CCCP Coffee</h2>
    <p>
      Кафе стоит на улице Хонг Банг ({v.street}) в центральной части Нячанга. Проще всего
      доехать на Grab — на такси или байке: введите в приложении «CCCP Coffee, Hồng Bàng». Если живёте в центре, дойти можно
      пешком.
    </p>
    <h2>Что есть на месте</h2>
    <p>
      В кафе большие столы, за которыми помещается вся компания, а также напитки и еда. Их вы заказываете и оплачиваете отдельно
      от игрового вечера.
    </p>
    <h2>Если не можете найти вход</h2>
    <p>
      Напишите ведущей в Telegram <a href={site.telegramDM} rel="noopener">{site.telegramDMHandle}</a> — подскажем, как пройти.
    </p>
  </section>
  <JoinBand />
</Base>

<style>
  .place-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 1.5rem;
    align-items: stretch;
  }
  .addr {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    background: var(--paper);
    color: var(--ink);
    border-radius: var(--radius-card);
    padding: 2rem;
    border-top: 10px solid var(--mafia);
  }
  .addr .name {
    font-family: var(--display);
    font-size: var(--step-3);
    margin-bottom: 0.4rem;
  }
  .addr .time {
    font-weight: 700;
    margin: 0.8rem 0 1.4rem;
  }
  .addr .btn {
    align-self: flex-start;
    margin-top: auto;
  }
  .map {
    border-radius: var(--radius-card);
    overflow: hidden;
    min-height: 22rem;
    box-shadow: 0 0 0 1px var(--line);
  }
  .map iframe {
    border: 0;
    width: 100%;
    height: 100%;
    min-height: 22rem;
    display: block;
  }
  @media (max-width: 760px) {
    .place-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
