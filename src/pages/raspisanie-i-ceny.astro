---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Week from '../components/Week.astro';
import Faq from '../components/Faq.astro';
import JoinBand from '../components/JoinBand.astro';
import { site, lila } from '../data/site';
import { breadcrumbs, faqSchema } from '../data/schema';

const crumb = [{ name: 'Расписание и цены', href: '/raspisanie-i-ceny/' }];
const faq = [
  {
    q: 'Сколько стоит вечер игр в Party Game?',
    a: 'Авалон и Тайный Гитлер — 150 000 донгов, городская мафия — 200 000 донгов за весь вечер с 19:00 до 23:00, независимо от числа партий. Оплата наличными ведущему в начале вечера.',
  },
  {
    q: 'Входят ли напитки в стоимость?',
    a: 'Нет, напитки и еду вы заказываете в кафе CCCP Coffee и оплачиваете отдельно.',
  },
  {
    q: 'Можно прийти не к началу?',
    a: 'Лучше прийти к 19:00, чтобы послушать правила и попасть в первую партию. Если опаздываете, предупредите ведущую — вас подключат к следующей партии.',
  },
  {
    q: 'Где смотреть актуальное расписание?',
    a: 'Постоянное расписание — на этой странице. Анонсы на неделю, изменения и свободные места публикуются в Telegram-группе клуба.',
  },
];
---

<Base
  title="Расписание и цены игр в Нячанге — мафия, Авалон, Тайный Гитлер | Party Game"
  description="Расписание клуба Party Game в Нячанге: Авалон по четвергам и воскресеньям, мафия по пятницам, Тайный Гитлер по субботам. 19:00–23:00, от 150 000 ₫ за вечер. Лила — от 70 $."
  schema={[breadcrumbs(crumb), faqSchema(faq)]}
>
  <Crumbs items={crumb} />
  <header class="page-hero wrap">
    <h1>Расписание и цены</h1>
    <p class="lede">
      Играем четыре вечера в неделю, с четверга по воскресенье, с 19:00 до 23:00 в {site.venue.name} ({site.venue.street}, центр
      Нячанга). Вечер Авалона или Тайного Гитлера стоит {site.priceText}, вечер мафии — 200 000 ₫.
    </p>
  </header>

  <section class="wrap">
    <h2 class="sr-only">Игровые вечера</h2>
    <Week />
  </section>

  <section class="section narrow prose">
    <h2>Что входит в стоимость</h2>
    <p>
      150 000 ₫ (мафия — 200 000 ₫) — это цена за весь вечер: объяснение правил, работа ведущего, игровой реквизит и 3–5 партий. Оплата
      ведущему наличными в начале вечера. Напитки и еда заказываются в кафе отдельно.
    </p>

    <h2>Лила с Юлианой</h2>
    <p>
      {lila.start[0].toUpperCase() + lila.start.slice(1)} Юлиана проводит игру самопознания <a href="/lila/">Лила</a> по
      понедельникам и средам днём, ориентировочно с 12:00 до 17:00. Сессия длится {lila.duration}.
    </p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Формат</th><th>Цена</th></tr></thead>
        <tbody>
          {lila.prices.map((p) => <tr><td>{p.label}</td><td>{p.price} {p.unit}</td></tr>)}
        </tbody>
      </table>
    </div>

    <h2>Как записаться</h2>
    <p>
      Зайдите в <a href={site.telegramGroup} rel="noopener">Telegram-группу клуба</a>, выберите игру в анонсе недели и запишитесь
      на неё. На Авалоне 13 мест, на Тайном Гитлере 10, поэтому лучше записываться заранее.
    </p>
  </section>

  <div class="narrow" style="padding-bottom:4rem">
    <Faq items={faq} />
  </div>
  <JoinBand />
</Base>
