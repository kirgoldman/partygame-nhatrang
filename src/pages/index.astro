---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroDoors from '../components/HeroDoors.astro';
import Ticker from '../components/Ticker.astro';
import NextGame from '../components/NextGame.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import Reviews from '../components/Reviews.astro';
import Week from '../components/Week.astro';
import Faq from '../components/Faq.astro';
import JoinBand from '../components/JoinBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { faqMain } from '../data/faq';
import { faqSchema, gameEvent } from '../data/schema';
import avalonImg from '../assets/photos/avalon-gruppa.jpg';
import hitlerImg from '../assets/photos/taynyy-gitler-igra.jpg';
import mafiaImg from '../assets/photos/mafiya-kompaniya.jpg';
import lilaImg from '../assets/photos/lila-5.jpg';

const title = 'Мафия, Авалон и Тайный Гитлер в Нячанге — клуб Party Game';
const description =
  'Клуб мафии, Авалона и Тайного Гитлера в центре Нячанга. Чт–Вс, 19:00–23:00, от 150 000 ₫ за вечер, на русском. Новичкам объясняем правила.';

const games = [
  {
    href: '/mafiya-nyachang/',
    name: 'Городская мафия',
    day: 'по пятницам',
    color: 'var(--mafia)',
    img: mafiaImg,
    alt: 'Компания игроков за вечером мафии клуба Party Game в Нячанге',
    text: 'Мафия — это игра, где город днём ищет среди жителей тайных преступников, а ночью мафия выбирает жертву. Здесь не спорят всерьёз: блефуют, читают людей и прокачивают навыки общения. Ведущий следит за ходом игры, а необычные роли добавляют неожиданных поворотов.',
  },
  {
    href: '/avalon/',
    name: 'Авалон',
    day: 'по четвергам и воскресеньям',
    color: 'var(--avalon)',
    img: avalonImg,
    alt: 'Игроки клуба Party Game за столом Авалона в CCCP Coffee, Нячанг',
    text: 'Авалон — это средневековая мафия, где рыцари короля Артура выполняют квесты, а шпионы Мордреда тайно их проваливают. Никто не выбывает: вся партия — это обсуждения, голосования и попытки вычислить предателя. Мудрый Мерлин знает злодеев, но не может сказать об этом прямо.',
  },
  {
    href: '/taynyy-gitler/',
    name: 'Тайный Гитлер',
    day: 'по субботам',
    color: 'var(--hitler)',
    img: hitlerImg,
    alt: 'Поле игры Тайный Гитлер с картами законов на столе в Нячанге',
    text: 'Тайный Гитлер — это игра на социальную дедукцию, где либералы и фашисты принимают законы и выбирают правительство. Можно быть уверенным, что раскусил человека, и вдруг понять, что всё это время играл по его сценарию. Партии короткие и насыщенные, почти без выбываний.',
  },
];

const schema = [
  faqSchema(faqMain),
  gameEvent('mafiya', 'Городская мафия', 'Городская мафия на русском каждую пятницу в центре Нячанга'),
  gameEvent('avalon', 'Авалон', 'Игра Авалон на русском по четвергам и воскресеньям в центре Нячанга'),
  gameEvent('taynyy-gitler', 'Тайный Гитлер', 'Игра Тайный Гитлер на русском по субботам в центре Нячанга'),
];
---

<Base title={title} description={description} schema={schema}>
  <section class="hero">
    <div class="wrap hero-in">
      <h1>Мафия, Авалон и Тайный Гитлер в&nbsp;Нячанге</h1>
      <p class="lede">
        Party Game — клуб социальных игр на русском. Играем четыре вечера в неделю в {site.venue.name} в центре Нячанга, с 19:00
        до 23:00. Вечер стоит от 150&nbsp;000&nbsp;донгов, правила объясняем за 5 минут.
      </p>
      <div class="btn-row hero-cta">
        <a class="btn btn-primary" href={site.telegramGroup} rel="noopener"><Icon name="telegram" /> Записаться на игру</a>
        <a class="btn btn-ghost" href="/raspisanie-i-ceny/">Расписание и цены</a>
      </div>
      <div class="hero-deck">
        <HeroDoors />
      </div>
    </div>
  </section>

  <section class="section week-sec" id="raspisanie">
    <div class="wrap">
      <NextGame />
      <div class="sec-head">
        <h2>Когда играем</h2>
        <ul class="sec-meta">
          <li>
            <a href={site.venue.mapUrl} rel="noopener" target="_blank">
              <span class="ic" aria-hidden="true"><Icon name="pin" /></span>
              <span><b>{site.venue.name}</b><small>{site.venue.street}, центр</small></span>
            </a>
          </li>
          <li>
            <span class="ic" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            </span>
            <span><b>{site.hours}</b><small>все игровые вечера</small></span>
          </li>
          <li>
            <a href={site.telegramGroup} rel="noopener" target="_blank">
              <span class="ic" aria-hidden="true"><Icon name="telegram" /></span>
              <span><b>Даты и места</b><small>в Telegram-группе клуба</small></span>
            </a>
          </li>
        </ul>
      </div>
      <Week />
    </div>
  </section>

  <section class="section evening">
    <div class="wrap">
      <h2>Как проходит вечер</h2>
      <ol class="timeline">
        <li>
          <span class="t">Заранее</span>
          <h3>Записываешься в группе</h3>
          <p>
            Заходишь в <a href={site.telegramGroup} rel="noopener">Telegram-группу клуба</a>, выбираешь игру в анонсе недели и
            записываешься на неё.
          </p>
        </li>
        <li>
          <span class="t">19:00</span>
          <h3>Собираемся и слушаем правила</h3>
          <p>Знакомимся, оплачиваем вечер ведущему — {site.priceText}, мафия — 200 000 ₫. Правила объясняем буквально за 5 минут.</p>
        </li>
        <li>
          <span class="t">19:05–23:00</span>
          <h3>Играем</h3>
          <p>3–5 партий за вечер. Роли каждый раз новые, компания перемешивается.</p>
        </li>
      </ol>
    </div>
  </section>

  <Ticker />

  <section class="section games" aria-labelledby="games-h">
    <div class="wrap">
      <h2 id="games-h">Во что мы играем</h2>
      <div class="game-list">
        {
          games.map((g) => (
            <article class="game" style={`--c:${g.color}`}>
              <a href={g.href} class="game-photo" tabindex="-1" aria-hidden="true">
                <Image src={g.img} alt={g.alt} widths={[480, 800]} sizes="(max-width: 760px) 100vw, 44vw" loading="lazy" />
              </a>
              <div class="game-body">
                <p class="game-day">{g.day}</p>
                <h3>
                  <a href={g.href}>{g.name}</a>
                </h3>
                <p>{g.text}</p>
                <a class="more" href={g.href}>
                  Подробнее про {g.name === 'Городская мафия' ? 'мафию' : g.name}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>


  <section class="lila-band" aria-labelledby="lila-h">
    <div class="wrap lila-in">
      <div class="lila-photo">
        <Image src={lilaImg} alt="Поле игры Лила, карты и кубики на столе" widths={[480, 900]} sizes="(max-width: 760px) 100vw, 40vw" loading="lazy" />
      </div>
      <div>
        <p class="lila-kicker">Днём, с середины октября</p>
        <h2 id="lila-h">Лила — игра самопознания с Юлианой</h2>
        <p>
          Лила — древняя индийская игра, в которой ты приходишь со своим запросом: про отношения, деньги, самоценность или
          предназначение. Кубик, клетки и символы поля помогают увидеть, что мешает и куда двигаться. Юлиана ведёт игру как
          коуч с опытом более 10 лет, сессия длится до пяти часов.
        </p>
        <a class="btn lila-btn" href="/lila/">Узнать про Лилу</a>
      </div>
    </div>
  </section>

  <PhotoStrip />

  <Reviews />

  <section class="section community">
    <div class="wrap comm-in">
      <a class="phone" href={site.telegramGroup} rel="noopener" aria-label="Открыть Telegram-группу клуба">
        <span class="btn-side action" aria-hidden="true"></span>
        <span class="btn-side vol-up" aria-hidden="true"></span>
        <span class="btn-side vol-down" aria-hidden="true"></span>
        <span class="btn-side power" aria-hidden="true"></span>
        <span class="bezel">
          <span class="phone-screen">
            <span class="status" aria-hidden="true">
              <span class="clock">19:00</span>
              <span class="island"></span>
              <span class="icons">
                <svg viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1" /><rect x="5" y="5.5" width="3" height="6.5" rx="1" /><rect x="10" y="3" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="12" rx="1" /></svg>
                <svg viewBox="0 0 16 12"><path d="M8 11.5 5.6 9a3.4 3.4 0 0 1 4.8 0z" /><path d="M3.4 6.8a6.5 6.5 0 0 1 9.2 0l-1.4 1.4a4.5 4.5 0 0 0-6.4 0z" /><path d="M1.1 4.5a9.7 9.7 0 0 1 13.8 0l-1.4 1.4a7.7 7.7 0 0 0-11 0z" /></svg>
                <svg viewBox="0 0 27 12"><rect x="0.5" y="0.5" width="23" height="11" rx="3.2" fill="none" stroke="currentColor" opacity="0.45" /><rect x="2.2" y="2.2" width="17" height="7.6" rx="1.8" /><path d="M25 4v4c.9-.3 1.5-1.1 1.5-2S25.9 4.3 25 4z" opacity="0.45" /></svg>
              </span>
            </span>
            <video src="/video/telegram-gruppa.mp4" poster="/video/telegram-gruppa.webp" autoplay muted loop playsinline preload="metadata" aria-label="Запись экрана Telegram-группы PARTY GAME community: анонсы игр и опросы для записи"></video>
            <span class="home-bar" aria-hidden="true"></span>
          </span>
        </span>
        <span class="phone-cta"><Icon name="telegram" /> Открыть группу</span>
      </a>
      <div>
        <p class="big-num">{site.groupSize}</p>
        <h2>человек уже в группе клуба</h2>
        <p class="muted">
          Туристы, зимовщики и те, кто переехал в Нячанг надолго. Многие пришли на одну игру, а остались ради компании. В группе
          анонсы на неделю, запись на игры и фото с вечеров.
        </p>
        <a class="btn btn-primary" href={site.telegramGroup} rel="noopener"><Icon name="users" /> Вступить в группу</a>
      </div>
    </div>
  </section>

  <section class="section place">
    <div class="wrap place-in">
      <div>
        <h2>Где мы играем</h2>
        <p>
          <strong>{site.venue.name}</strong> — кафе в центре Нячанга по адресу {site.venue.street}. Уютный зал с большими столами,
          напитки и еда на месте.
        </p>
        <p class="btn-row">
          <a class="btn btn-ghost" href={site.venue.mapUrl} rel="noopener"><Icon name="pin" /> Маршрут в Google Maps</a>
          <a class="btn btn-ghost" href="/gde-my-igraem/">Как добраться</a>
        </p>
      </div>
      <address class="addr-card">
        <span class="addr-name">{site.venue.name}</span>
        <span>{site.venue.street}</span>
        <span>{site.venue.cityLatin}, {site.venue.region}</span>
        <span class="addr-time">Чт–Вс, {site.hours}</span>
      </address>
    </div>
  </section>

  <div class="section narrow">
    <Faq items={faqMain} />
    <p class="faq-more"><a href="/voprosy/">Все вопросы и ответы</a></p>
  </div>

  <JoinBand />
</Base>

<style>
  .hero {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    /* мягкий свет лампы над столом */
    content: '';
    position: absolute;
    right: -10%;
    top: -30%;
    width: 70%;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgba(255, 59, 92, 0.22), transparent 70%);
    pointer-events: none;
  }
  .hero-in {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas: 'title' 'lede' 'deck' 'cta';
    justify-items: center;
    text-align: center;
    position: relative;
  }
  .hero h1 {
    grid-area: title;
    font-size: clamp(2.3rem, 0.9rem + 3.4vw, 4rem);
    max-width: 18ch;
    margin: 0 0 1.1rem;
  }
  .hero .lede {
    grid-area: lede;
    max-width: 52ch;
    margin: 0 auto;
    font-size: var(--step-1);
  }
  .hero-deck {
    grid-area: deck;
    width: 100%;
    min-width: 0;
    margin-top: clamp(2rem, 4vw, 2.75rem);
    text-align: left;
  }
  .hero-cta {
    grid-area: cta;
    justify-content: center;
    margin-top: clamp(1.75rem, 3vw, 2.25rem);
  }
  @media (max-width: 760px) {
    .hero-in {
      justify-items: start;
      text-align: left;
    }
    .hero-cta {
      justify-content: flex-start;
    }
  }

  .week-sec {
    background: var(--felt);
    border-block: 1px solid var(--line);
  }
  .sec-head {
    margin-bottom: 2.2rem;
  }
  .sec-head h2 {
    margin: 0 0 1.4rem;
  }
  .sec-meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .sec-meta li > a,
  .sec-meta li:not(:has(a)) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1.1rem 0.7rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--night);
    color: var(--text);
    text-decoration: none;
    line-height: 1.2;
  }
  .sec-meta li > a {
    transition: border-color 0.2s, transform 0.2s;
  }
  .sec-meta li > a:hover {
    border-color: var(--avalon);
    transform: translateY(-2px);
  }
  .sec-meta .ic {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    flex: none;
    border-radius: 50%;
    background: var(--felt-2);
    color: var(--avalon);
  }
  .sec-meta .ic :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }
  .sec-meta b {
    display: block;
    font-weight: 700;
  }
  .sec-meta small {
    display: block;
    color: var(--muted);
    font-size: 0.82rem;
  }
  @media (max-width: 640px) {
    .sec-meta li {
      flex: 1 1 100%;
    }
  }

  .timeline {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    top: 0.72rem;
    left: 0;
    right: 0;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--line) 0 8px, transparent 8px 14px);
  }
  .timeline li {
    position: relative;
    padding: 2.4rem 1.5rem 0 0;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    top: 0.3rem;
    left: 0;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--night);
    border: 3px solid var(--avalon);
  }
  .timeline .t {
    font-weight: 700;
    color: var(--avalon);
    font-variant-numeric: tabular-nums;
  }
  .timeline h3 {
    font-size: var(--step-2);
    margin: 0.3rem 0 0.5rem;
  }
  .timeline p {
    color: var(--muted);
    font-size: 0.98rem;
  }
  @media (max-width: 820px) {
    .timeline {
      grid-template-columns: 1fr;
    }
    .timeline::before {
      top: 0;
      bottom: 0;
      left: 0.45rem;
      right: auto;
      width: 2px;
      height: auto;
      background: repeating-linear-gradient(180deg, var(--line) 0 8px, transparent 8px 14px);
    }
    .timeline li {
      padding: 0 0 1.8rem 2.4rem;
    }
    .timeline li::before {
      top: 0.25rem;
    }
  }

  .games {
    padding-top: 1rem;
  }
  .game-list {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    margin-top: 2.5rem;
  }
  .game {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .game:nth-child(even) .game-photo {
    order: 2;
  }
  .game-photo {
    display: block;
    border-radius: var(--radius-card);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    box-shadow: 0 0 0 1px var(--line);
    position: relative;
  }
  .game-photo::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 8px;
    background: var(--c);
  }
  .game-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .game-day {
    color: var(--c);
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
  .game h3 {
    font-size: var(--step-2);
  }
  .game h3 a {
    text-decoration: none;
  }
  .game-body p:not(.game-day) {
    color: var(--muted);
  }
  .more {
    font-weight: 650;
    color: var(--c);
  }
  @media (max-width: 760px) {
    .game {
      grid-template-columns: 1fr;
    }
    .game:nth-child(even) .game-photo {
      order: 0;
    }
  }

  .lila-band {
    background: #4a1a63;
    color: #fff;
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }
  .lila-in {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }
  .lila-photo {
    border-radius: 200px 200px var(--radius-card) var(--radius-card);
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }
  .lila-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lila-kicker {
    color: #f3b8ff;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .lila-band h2 {
    font-size: var(--step-3);
  }
  .lila-band p {
    color: #eedcf5;
  }
  .lila-btn {
    background: var(--lila);
    color: #fff;
    margin-top: 0.5rem;
  }
  .lila-btn:hover {
    background: #e07af2;
  }
  @media (max-width: 760px) {
    .lila-in {
      grid-template-columns: 1fr;
    }
    .lila-photo {
      max-width: 22rem;
    }
  }

  .comm-in {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2rem clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .phone {
    position: relative;
    display: block;
    width: clamp(15rem, 23vw, 18rem);
    padding: 4px;
    border-radius: 3.3rem;
    /* титановая рамка */
    background: linear-gradient(135deg, #a7acb4 0%, #4a4e55 18%, #c9cdd3 38%, #5a5e65 55%, #8e939b 78%, #3c3f45 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.35),
      0 40px 70px rgba(8, 2, 18, 0.65),
      0 0 90px rgba(63, 201, 185, 0.16);
    transform: rotate(-4deg);
    transition: transform 0.3s ease;
    text-decoration: none;
  }
  .phone:hover,
  .phone:focus-visible {
    transform: rotate(-2deg) translateY(-0.4rem);
  }
  .btn-side {
    position: absolute;
    width: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, #3c3f45, #a7acb4 60%, #5a5e65);
  }
  .btn-side.action {
    left: -3px;
    top: 17%;
    height: 5%;
  }
  .btn-side.vol-up {
    left: -3px;
    top: 25%;
    height: 9%;
  }
  .btn-side.vol-down {
    left: -3px;
    top: 36%;
    height: 9%;
  }
  .btn-side.power {
    right: -3px;
    top: 28%;
    height: 14%;
  }
  .bezel {
    display: block;
    padding: 0.5rem;
