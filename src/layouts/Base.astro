---
import '@fontsource/dela-gothic-one/cyrillic-400.css';
import '@fontsource/dela-gothic-one/latin-400.css';
import '@fontsource-variable/onest/index.css';
import '../styles/global.css';
import { site, nav } from '../data/site';
import { club, website, graph } from '../data/schema';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  ogImage?: string;
  dockText?: string;
  dockHref?: string;
  ogType?: 'website' | 'article';
  accent?: string;
}

const { title, description, schema = [], ogImage = '/og.png', ogType = 'website', accent, dockText = 'Записаться на игру', dockHref = site.telegramGroup } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogUrl = new URL(ogImage, site.url).toString();
const path = Astro.url.pathname;
const ld = graph(club, website, ...schema);
import Metrika from '../components/Metrika.astro';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#1e1230" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="geo.region" content="VN-34" />
    <meta name="geo.placename" content="Nha Trang" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <Metrika />
  </head>
  <body style={accent ? `--accent:${accent}` : undefined}>
    <a class="skip" href="#main">К содержанию</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="brand" href="/" aria-label={`${site.name} — на главную`}>
          <Logo size={54} />
          <span class="brand-text">Party Game <small>Мафия и настольные игры, Нячанг</small></span>
        </a>
        <nav class="nav" aria-label="Основное меню">
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="btn btn-primary top-cta" href={site.telegramGroup} rel="noopener">Записаться</a>
        <details class="menu">
          <summary aria-label="Меню"><span></span><span></span></summary>
          <ul>
            {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            <li><a href="/gde-my-igraem/">Где играем</a></li>
            <li><a href="/o-klube/">О клубе</a></li>
            <li><a href="/voprosy/">Вопросы</a></li>
          </ul>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-grid">
        <div class="foot-about">
          <p class="foot-brand">Party Game Нячанг</p>
          <p class="muted">
            {site.tagline}. Мафия, Авалон и Тайный Гитлер по-русски, четыре вечера в неделю в центре Нячанга.
          </p>
        </div>
        <address class="foot-nap">
          <strong>{site.venue.name}</strong><br />
          {site.venue.street}, {site.venue.cityLatin}, {site.venue.region} {site.venue.postalCode}, {site.venue.countryRu}<br />
          Чт–Вс, {site.hours}<br />
          <a href={site.venue.mapUrl} rel="noopener">Открыть в Google Maps</a>
        </address>
        <nav class="foot-nav" aria-label="Все разделы">
          <ul>
            <li><a href="/mafiya-nyachang/">Мафия в Нячанге</a></li>
            <li><a href="/avalon/">Авалон</a></li>
            <li><a href="/taynyy-gitler/">Тайный Гитлер</a></li>
            <li><a href="/lila/">Игра Лила</a></li>
            <li><a href="/raspisanie-i-ceny/">Расписание и цены</a></li>
            <li><a href="/gde-my-igraem/">Где играем</a></li>
            <li><a href="/o-klube/">О клубе</a></li>
            <li><a href="/voprosy/">Частые вопросы</a></li>
            <li><a href="/blog/">Блог</a></li>
          </ul>
        </nav>
        <div class="foot-contact">
          <p><a href={site.telegramGroup} rel="noopener">Запись на игры: Telegram-группа клуба</a></p>
          <p><a href={site.telegramDM} rel="noopener">Вопросы и Лила: {site.telegramDMHandle}</a></p>
          {site.instagram && <p><a href={site.instagram} rel="noopener">Instagram Юлианы</a></p>}
        </div>
      </div>
      <div class="wrap foot-base muted">© {new Date().getFullYear()} {site.name}</div>
    </footer>

    <a class="dock" href={dockHref} rel="noopener">
      <Icon name="telegram" /> {dockText}
    </a>
    <script>
      // Плавающая кнопка появляется, когда пролистали первый экран
      const dock = document.querySelector<HTMLElement>('.dock');
      if (dock) {
        const upd = () => dock.classList.toggle('is-on', window.scrollY > window.innerHeight * 0.75);
        upd();
        window.addEventListener('scroll', upd, { passive: true });
      }
    </script>
  </body>
</html>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--night) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
  }
  .top-in {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4.25rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    margin-right: auto;
  }
  .brand-mark {
    position: relative;
    width: 1.7rem;
    height: 2rem;
  }
  .brand-mark span {
    position: absolute;
    inset: 0;
    border-radius: 4px;
    border: 2px solid var(--paper);
  }
  .brand-mark span:first-child {
    background: var(--mafia);
    transform: rotate(-12deg) translateX(-3px);
  }
  .brand-mark span:last-child {
    background: var(--avalon);
    transform: rotate(8deg) translateX(4px);
  }
  .brand-text {
    font-family: var(--display);
    font-size: 1.2rem;
    line-height: 1;
  }
  .brand-text small {
    font-family: var(--body);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
    display: block;
    margin-top: 0.2rem;
  }
  .nav ul {
    display: flex;
    gap: 1.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    text-decoration: none;
    font-size: 0.97rem;
    color: var(--muted);
  }
  .nav a:hover,
  .nav a[aria-current] {
    color: var(--text);
  }
  .nav a[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--mafia);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
  .top-cta {
    padding: 0.65em 1.2em;
    font-size: 0.95rem;
  }
  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    list-style: none;
    cursor: pointer;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-content: center;
    gap: 6px;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    transition: transform 0.2s ease;
  }
  .menu[open] summary span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .menu[open] summary span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }
  .menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    background: var(--felt);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    min-width: 14rem;
    box-shadow: 0 20px 40px rgba(10, 4, 20, 0.5);
  }
  .menu a {
    display: block;
    padding: 0.7rem 0.9rem;
    text-decoration: none;
    border-radius: 8px;
  }
  .menu a:hover {
    background: var(--felt-2);
  }

  @media (max-width: 960px) {
    .nav,
    .top-cta {
      display: none;
    }
    .menu {
      display: block;
    }
  }

  .foot {
    background: #170d26;
    border-top: 1px solid var(--line);
    padding: 3.5rem 0 6rem;
    font-size: 0.95rem;
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 1.3fr 1.2fr 1fr 1fr;
    gap: 2rem;
  }
  .foot-brand {
    font-family: var(--display);
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
  }
  .foot-nap {
    font-style: normal;
    line-height: 1.7;
  }
  .foot ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  .foot a {
    text-decoration: none;
  }
  .foot a:hover {
    text-decoration: underline;
  }
  .foot-contact p {
    margin-bottom: 0.4rem;
  }
  .foot-base {
    margin-top: 2.5rem;
    font-size: 0.85rem;
  }
  @media (max-width: 860px) {
    .foot-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .foot-grid {
      grid-template-columns: 1fr;
    }
  }

  .dock {
    display: none;
  }
  @media (max-width: 720px) {
    .dock {
      position: fixed;
      left: 1rem;
      right: 1rem;
      bottom: max(1rem, env(safe-area-inset-bottom));
      z-index: 60;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.6rem;
      padding: 1rem;
      border-radius: 999px;
      background: var(--mafia);
      color: #fff;
      font-weight: 700;
      text-decoration: none;
      box-shadow: 0 12px 30px rgba(255, 59, 92, 0.35);
      transform: translateY(calc(100% + 2rem));
      opacity: 0;
      pointer-events: none;
      transition: transform 0.3s ease, opacity 0.3s ease;
    }
    .dock.is-on {
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }
    .dock :global(svg) {
      width: 1.2em;
      height: 1.2em;
    }
  }
</style>
