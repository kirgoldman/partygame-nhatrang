---
// Вертикальное видео с игры: автозапуск без звука, кнопка «Включить звук».
// Звук одновременно включается только у одного видео на странице.
interface Props {
  src: string;
  poster: string;
  label: string;
  sound?: boolean;
}
const { src, poster, label, sound = false } = Astro.props;
---

<figure class="club-video">
  <video src={src} poster={poster} autoplay muted loop playsinline preload="metadata" aria-label={label}></video>
  {
    sound && (
      <button type="button" class="cv-sound" aria-pressed="false">
        <span>Включить звук</span>
      </button>
    )
  }
</figure>

<script>
  const all = () => Array.from(document.querySelectorAll<HTMLElement>('.club-video'));
  all().forEach((fig) => {
    const v = fig.querySelector('video')!;
    const b = fig.querySelector<HTMLButtonElement>('.cv-sound');
    b?.addEventListener('click', () => {
      const on = v.muted;
      all().forEach((f) => {
        const vv = f.querySelector('video')!;
        vv.muted = true;
        const bb = f.querySelector<HTMLButtonElement>('.cv-sound');
        if (bb) {
          bb.setAttribute('aria-pressed', 'false');
          bb.querySelector('span')!.textContent = 'Включить звук';
        }
      });
      v.muted = !on;
      b.setAttribute('aria-pressed', String(on));
      b.querySelector('span')!.textContent = on ? 'Выключить звук' : 'Включить звук';
      if (on) v.play().catch(() => {});
    });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? v.play().catch(() => {}) : v.pause())), {
        threshold: 0.3,
      }).observe(v);
    }
  });
</script>

<style>
  .club-video {
    position: relative;
    margin: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    aspect-ratio: 9 / 16;
    background: var(--felt);
    box-shadow: 0 0 0 1px var(--line), 0 26px 50px rgba(8, 2, 18, 0.5);
  }
  .club-video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cv-sound {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.55rem 0.95rem;
    border: 0;
    border-radius: 999px;
    background: rgba(30, 18, 48, 0.78);
    backdrop-filter: blur(6px);
    color: #fff;
    font: 600 0.85rem/1 var(--body);
    cursor: pointer;
  }
  .cv-sound[aria-pressed='true'],
  .cv-sound:hover {
    background: var(--mafia);
  }
</style>
