---
// Лента фото и видео с вечеров, медленно едет сама. По клику открывается
// увеличенный просмотр (не на весь экран) с кнопкой звука у видео.
// Новые фото кладите в src/assets/photos/ и добавляйте в список ниже.
import { Image, getImage } from 'astro:assets';
import a from '../assets/photos/avalon-gruppa.jpg';
import b from '../assets/photos/taynyy-gitler-igra.jpg';
import c from '../assets/photos/lila-1.jpg';
import d from '../assets/photos/mafiya-kompaniya.jpg';
import e from '../assets/photos/lila-5.jpg';

type Item = { src?: any; video?: string; poster?: string; w?: number; h?: number; alt: string };
const items: Item[] = [
  { src: a, alt: 'Вечер Авалона в CCCP Coffee' },
  { video: '/video/igra-taynyy-gitler.mp4', poster: '/video/igra-taynyy-gitler.webp', w: 640, h: 1136, alt: 'Вечер Тайного Гитлера: игроки спорят за столом' },
  { src: b, alt: 'Партия в Тайного Гитлера' },
  { video: '/video/igra-taynyy-gitler-2.mp4', poster: '/video/igra-taynyy-gitler-2.webp', w: 540, h: 960, alt: 'Тайный Гитлер: смех и споры за столом' },
  { src: c, alt: 'Игра Лила с Юлианой' },
  { video: '/video/igra-avalon.mp4', poster: '/video/igra-avalon.webp', w: 352, h: 640, alt: 'Вечер Авалона: жаркое обсуждение за столом' },
  { video: '/video/igra-mafiya.mp4', poster: '/video/igra-mafiya.webp', w: 352, h: 640, alt: 'Вечер городской мафии: ведущий и игроки' },
  { src: d, alt: 'Вечер мафии: вся компания за столом' },
  { src: e, alt: 'Поле игры Лила' },
];

// Данные для увеличенного просмотра: крупная версия фото или видео
const full = await Promise.all(
  items.map(async (p) =>
    p.video
      ? { type: 'video', src: p.video, poster: p.poster, alt: p.alt }
      : { type: 'image', src: (await getImage({ src: p.src, width: Math.min(1400, p.src.width), format: 'webp' })).src, alt: p.alt },
  ),
);
const ratio = (p: Item) => (p.video ? `${p.w} / ${p.h}` : `${Math.max(p.src.width / p.src.height, 0.6).toFixed(3)} / 1`);
---

<section class="strip" aria-labelledby="strip-h">
  <div class="wrap strip-head">
    <h2 id="strip-h">Контент с игр</h2>
    <p class="muted">Фото и видео с наших вечеров. Нажмите, чтобы увеличить и включить звук.</p>
  </div>
  <div class="scroller">
  <div class="rail">
    {
      [0, 1].map((copy) =>
        items.map((p, i) => (
          <button
            type="button"
            class:list={['tile', p.video && 'is-video']}
            data-i={i}
            style={`--ar: ${ratio(p)}`}
            aria-hidden={copy === 1 ? 'true' : undefined}
            tabindex={copy === 1 ? -1 : undefined}
            aria-label={`Открыть: ${p.alt}`}
          >
            {p.video ? (
              <video src={p.video} poster={p.poster} autoplay muted loop playsinline preload="metadata" />
            ) : (
              <Image src={p.src} alt={copy === 1 ? '' : p.alt} widths={[360, 720]} sizes="22rem" loading="lazy" />
            )}
            <span class="zoom" aria-hidden="true">
              {p.video ? (
                <svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.5 4.5 0 0 0 2.5-4z" /></svg>
              ) : (
                <svg viewBox="0 0 24 24" width="16" height="16"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" d="M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13zM20 20l-4.8-4.8M10.5 7.5v6M7.5 10.5h6" /></svg>
              )}
            </span>
          </button>
        )),
      )
    }
  </div>
  </div>
  <div class="wrap strip-ctrl">
    <button type="button" class="sc-btn sc-prev" aria-label="Листать назад">
      <svg viewBox="0 0 24 24" width="22" height="22"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7" /></svg>
    </button>
    <span class="sc-hint">листайте или тяните ленту</span>
    <button type="button" class="sc-btn sc-next" aria-label="Листать вперёд">
      <svg viewBox="0 0 24 24" width="22" height="22"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
    </button>
  </div>
</section>

<dialog class="lb" aria-label="Просмотр фото и видео">
  <div class="lb-stage">
    <div class="lb-media"></div>
    <button type="button" class="lb-sound" aria-pressed="false" hidden><span>Включить звук</span></button>
    <button type="button" class="lb-close" aria-label="Закрыть">
      <svg viewBox="0 0 24 24" width="20" height="20"><path stroke="currentColor" stroke-width="2.4" stroke-linecap="round" d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <button type="button" class="lb-nav lb-prev" aria-label="Предыдущее">
      <svg viewBox="0 0 24 24" width="22" height="22"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7" /></svg>
    </button>
    <button type="button" class="lb-nav lb-next" aria-label="Следующее">
      <svg viewBox="0 0 24 24" width="22" height="22"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
    </button>
  </div>
  <p class="lb-cap"></p>
</dialog>

<script is:inline type="application/json" id="lb-data" set:html={JSON.stringify(full)} />

<script>
  type Full = { type: 'video' | 'image'; src: string; poster?: string; alt: string };
  const data: Full[] = JSON.parse(document.getElementById('lb-data')!.textContent || '[]');
  const strip = document.querySelector<HTMLElement>('.strip')!;
  const dlg = document.querySelector<HTMLDialogElement>('.lb')!;
  const box = dlg.querySelector<HTMLElement>('.lb-media')!;
  const cap = dlg.querySelector<HTMLElement>('.lb-cap')!;
  const snd = dlg.querySelector<HTMLButtonElement>('.lb-sound')!;
  let cur = 0;

  // Лента: сама медленно едет, её можно листать пальцем, колесом, мышью и стрелками
  const sc = strip.querySelector<HTMLElement>('.scroller')!;
  const rail = strip.querySelector<HTMLElement>('.rail')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let pausedUntil = 0;
  let hover = false;
  let pos = 0;
  const half = () => rail.scrollWidth / 2;
  const wrap = () => {
    const h = half();
    if (sc.scrollLeft >= h) sc.scrollLeft -= h;
    else if (sc.scrollLeft <= 0) sc.scrollLeft += h;
  };
  const hold = (ms = 3000) => (pausedUntil = performance.now() + ms);
  const tick = (t: number) => {
    if (!reduce && !hover && !dlg.open && t > pausedUntil) {
      pos = (Math.abs(pos - sc.scrollLeft) > 2 ? sc.scrollLeft : pos) + 0.5;
      sc.scrollLeft = pos;
      wrap();
      pos = sc.scrollLeft;
    }
    requestAnimationFrame(tick);
  };
  requestAnimationFrame(tick);
  sc.addEventListener('scroll', () => { if (performance.now() < pausedUntil) wrap(); }, { passive: true });
  sc.addEventListener('mouseenter', () => (hover = true));
  sc.addEventListener('mouseleave', () => (hover = false));
  ['touchstart', 'wheel'].forEach((ev) => sc.addEventListener(ev, () => hold(), { passive: true }));
  const step = (dir: number) => {
    hold(4000);
    const w = (rail.querySelector('.tile') as HTMLElement).offsetWidth + 16;
    sc.scrollBy({ left: dir * w * 1.5, behavior: 'smooth' });
  };
  strip.querySelector('.sc-prev')!.addEventListener('click', () => step(-1));
  strip.querySelector('.sc-next')!.addEventListener('click', () => step(1));
  // Перетаскивание мышью; если тянули — клик не открывает окно
  let dragX: number | null = null, startLeft = 0, moved = false;
  sc.addEventListener('pointerdown', (e) => {
    if (e.pointerType !== 'mouse') return;
    dragX = e.clientX; startLeft = sc.scrollLeft; moved = false;
  });
  window.addEventListener('pointermove', (e) => {
    if (dragX === null) return;
    const dx = e.clientX - dragX;
    if (Math.abs(dx) > 5) { moved = true; sc.classList.add('dragging'); }
    if (moved) { sc.scrollLeft = startLeft - dx; wrap(); hold(); }
  });
  window.addEventListener('pointerup', () => { dragX = null; sc.classList.remove('dragging'); });
  sc.addEventListener('click', (e) => { if (moved) { e.stopPropagation(); e.preventDefault(); moved = false; } }, true);

  const setSound = (on: boolean) => {
    snd.setAttribute('aria-pressed', String(on));
    snd.querySelector('span')!.textContent = on ? 'Выключить звук' : 'Включить звук';
  };

  const show = (i: number) => {
    cur = (i + data.length) % data.length;
    const it = data[cur];
    box.innerHTML = '';
    if (it.type === 'video') {
      const v = document.createElement('video');
      Object.assign(v, { src: it.src, poster: it.poster || '', autoplay: true, loop: true, muted: true, playsInline: true });
      v.setAttribute('playsinline', '');
      v.setAttribute('aria-label', it.alt);
      box.append(v);
      v.play().catch(() => {});
      snd.hidden = false;
      setSound(false);
    } else {
      const img = document.createElement('img');
      img.src = it.src;
      img.alt = it.alt;
      box.append(img);
      snd.hidden = true;
    }
    cap.textContent = it.alt;
  };

  snd.addEventListener('click', () => {
    const v = box.querySelector('video');
    if (!v) return;
    const on = v.muted;
    // Выключаем звук у остальных видео на странице
    document.querySelectorAll('video').forEach((o) => {
      if (o !== v) o.muted = true;
    });
    document.querySelectorAll('.cv-sound').forEach((b) => {
      b.setAttribute('aria-pressed', 'false');
      const s = b.querySelector('span');
      if (s) s.textContent = 'Включить звук';
    });
    v.muted = !on;
    setSound(on);
    if (on) v.play().catch(() => {});
  });

  strip.querySelectorAll<HTMLButtonElement>('.tile').forEach((t) =>
    t.addEventListener('click', () => {
      show(Number(t.dataset.i));
            dlg.showModal();
    }),
  );
  dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(cur - 1));
  dlg.querySelector('.lb-next')!.addEventListener('click', () => show(cur + 1));
  dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
  // Клик по затемнённому фону закрывает
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(cur - 1);
    if (e.key === 'ArrowRight') show(cur + 1);
  });
  // Свайп на телефоне
  let x0: number | null = null;
  dlg.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  dlg.addEventListener(
    'touchend',
    (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1));
      x0 = null;
    },
    { passive: true },
  );
  dlg.addEventListener('close', () => {
    box.innerHTML = '';
  });
</script>

<style>
  .strip {
    overflow: hidden;
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  .scroller {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }
  .scroller::-webkit-scrollbar {
    display: none;
  }
  .scroller.dragging {
    cursor: grabbing;
  }
  .scroller.dragging .tile {
    pointer-events: none;
  }
  .rail {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: max-content;
    padding: 0.8rem 1rem;
  }
  .strip-ctrl {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.9rem;
  }
  .sc-btn {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--felt);
    color: var(--text);
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  .sc-btn:hover {
    background: var(--felt-2);
    border-color: var(--avalon);
  }
  .sc-hint {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .tile {
    --h: clamp(17rem, 28vw, 23rem);
    position: relative;
    flex: none;
    height: var(--h);
    aspect-ratio: var(--ar);
    max-width: calc(var(--h) * 1.7);
    padding: 0;
    border: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--felt);
    cursor: zoom-in;
    box-shadow: 0 0 0 1px var(--line), 0 18px 36px rgba(8, 2, 18, 0.45);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .tile:nth-child(odd) {
    transform: rotate(-1.5deg);
  }
  .tile:nth-child(even) {
    transform: rotate(1.5deg);
  }
  .tile:hover,
  .tile:focus-visible {
    transform: rotate(0) scale(1.03);
    box-shadow: 0 0 0 2px var(--avalon), 0 24px 44px rgba(8, 2, 18, 0.55);
    outline: none;
  }
  .tile video,
  .tile :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Видео показываем целиком, без обрезки */
  .tile.is-video video {
    object-fit: contain;
    background: #000;
  }
  .zoom {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: rgba(30, 18, 48, 0.75);
    backdrop-filter: blur(6px);
    color: #fff;
    transition: background 0.2s;
  }
  .tile:hover .zoom {
    background: var(--mafia);
  }
  .strip-head {
    margin-bottom: 1.2rem;
  }
  .strip-head h2 {
    margin: 0 0 0.5rem;
  }
  .strip-head p {
    margin: 0;
  }


  /* Увеличенный просмотр — окно поверх страницы, не на весь экран */
  .lb {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: none;
    max-height: none;
    overflow: visible;
    color: var(--paper);
  }
  .lb::backdrop {
    background: rgba(14, 6, 26, 0.82);
    backdrop-filter: blur(8px);
  }
  .lb[open] {
    animation: pop 0.22s ease-out;
  }
  .lb-stage {
    position: relative;
  }
  .lb-media :global(img),
  .lb-media :global(video) {
    display: block;
    max-width: min(86vw, 60rem);
    max-height: 78vh;
    width: auto;
    height: auto;
    border-radius: var(--radius-card);
    background: #000;
    box-shadow: 0 0 0 1px var(--line), 0 30px 70px rgba(0, 0, 0, 0.6);
  }
  .lb-sound {
    position: absolute;
    left: 50%;
    bottom: 0.9rem;
    transform: translateX(-50%);
    padding: 0.7rem 1.15rem;
    border: 0;
    border-radius: 999px;
    background: rgba(30, 18, 48, 0.8);
    backdrop-filter: blur(6px);
    color: #fff;
    font: 600 0.95rem/1 var(--body);
    white-space: nowrap;
    cursor: pointer;
  }
  .lb-sound[aria-pressed='true'],
  .lb-sound:hover {
    background: var(--mafia);
  }
  .lb-close {
    position: absolute;
    top: -0.9rem;
    right: -0.9rem;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 0;
    border-radius: 50%;
    background: var(--paper);
    color: var(--night);
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.4);
  }
  .lb-nav {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border: 0;
    border-radius: 50%;
    background: rgba(246, 238, 226, 0.14);
    color: #fff;
    cursor: pointer;
    transform: translateY(-50%);
  }
  .lb-nav:hover {
    background: rgba(246, 238, 226, 0.3);
  }
  .lb-prev {
    left: -3.6rem;
  }
  .lb-next {
    right: -3.6rem;
  }
  .lb-cap {
    margin: 0.8rem 0 0;
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
  }
  @media (max-width: 640px) {
    .lb-media :global(img),
    .lb-media :global(video) {
      max-width: 88vw;
      max-height: 72vh;
    }
    .lb-prev {
      left: 0.4rem;
    }
    .lb-next {
      right: 0.4rem;
    }
    .lb-nav {
      background: rgba(30, 18, 48, 0.6);
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }
</style>
