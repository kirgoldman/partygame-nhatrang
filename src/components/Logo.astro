<rect x="10.5" y="10.5" width="18" height="28" rx="2" fill="none" stroke="#f5b82e" stroke-width="0.8" opacity="0.6" transform="rotate(-14 19.5 24.5)"/>
<g transform="rotate(7 28 25)">
<rect x="15" y="5" width="26" height="37" rx="3.5" fill="#f6eee2" stroke="#1e1230" stroke-width="0.8"/>
<rect x="17.2" y="7.2" width="21.6" height="32.6" rx="2" fill="none" stroke="#ff3b5c" stroke-width="1"/>
<path d="M19.6 39.8c0-6.2 3.4-9.2 8.4-9.2s8.4 3 8.4 9.2z" fill="#1e1230"/>
<path d="M27 30.7h2l.7 1.8-1.7 5.2-1.7-5.2z" fill="#ff3b5c"/>
<ellipse cx="28" cy="26.2" rx="3.5" ry="4" fill="#1e1230"/>
