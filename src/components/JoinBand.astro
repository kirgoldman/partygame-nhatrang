---
import { site } from '../data/site';
import Icon from './Icon.astro';
interface Props {
  title?: string;
  text?: string;
  button?: string;
  href?: string;
}
const {
  title = 'Приходи на игру',
  button = 'Записаться в группе',
  href = site.telegramGroup,
  text = 'Заходи в Telegram-группу клуба: там анонсы игр на неделю. Выбираешь вечер и записываешься прямо в группе. Мест за столом ограниченное количество, поэтому запись обязательна.',
} = Astro.props;
---

<section class="join">
  <div class="wrap join-in">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn-primary" href={href} rel="noopener"><Icon name="telegram" /> {button}</a>
      <a class="btn btn-ghost" href="/raspisanie-i-ceny/">Расписание и цены</a>
    </div>
  </div>
</section>

<style>
  .join {
    background: var(--felt);
    border-top: 1px solid var(--line);
    padding-block: clamp(3rem, 7vw, 5rem);
  }
  .join-in {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    align-items: end;
  }
  .join h2 {
    font-size: var(--step-3);
  }
  .join p {
    color: var(--muted);
    margin: 0;
  }
  .join .btn-row {
    justify-content: flex-end;
  }
  @media (max-width: 820px) {
    .join-in {
      grid-template-columns: 1fr;
    }
    .join .btn-row {
      justify-content: flex-start;
    }
  }
</style>
